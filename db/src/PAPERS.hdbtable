COLUMN TABLE "PAPERS" (
  "ID" NVARCHAR(255) NOT NULL,
  "TITLE" NVARCHAR(1000) NOT NULL,
  "DOMAIN" NVARCHAR(255) NOT NULL,
  "ABSTRACT" NCLOB,
  "AUTHORS" NVARCHAR(2000),
  "YEAR" INTEGER,
  "LIMITATIONS_TEXT" NCLOB,
  "METHOD_TEXT" NCLOB,
  "SOURCE" NVARCHAR(64),
  "FILE_NAME" NVARCHAR(512),
  "CONTENT_TYPE" NVARCHAR(128),
  "FILE_DATA" BLOB,
  "CREATED_AT" TIMESTAMP,
  PRIMARY KEY ("ID")
)
